# Copy to .env and fill in one provider. Discovery needs a live LLM;
# replay, tests, and the operator handoff do not.

# OpenAI (default)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Or any OpenAI-compatible endpoint (Azure, Groq, local vLLM, etc.)
# OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic (used when ANTHROPIC_API_KEY is set and --llm anthropic)
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Local Ollama (no paid key): ollama serve && ollama pull llama3.2:3b
# then: cuas discover --llm ollama ...
# OLLAMA_MODEL=llama3.2:3b

# Optional: override the mock core's bind address
# COREBANK_HOST=127.0.0.1
# COREBANK_PORT=8787
